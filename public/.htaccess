# Zunova Digital — Apache (GoDaddy) hosting.
# Every page is prerendered at build time to /<route>.html (and /<route>/index.html),
# so these rules serve the right file for clean URLs like /about.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  Options +FollowSymLinks -MultiViews
  DirectorySlash Off
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and drop "www." so there is one canonical address
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://zunovadigital.com%{REQUEST_URI} [R=301,L,NE]

  # Trailing slashes redirect to the clean URL (/about/ -> /about)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /index.html and /<page>.html redirect to the clean URL so each page has one address
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([a-z/-]+)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteRule ^([a-z/-]+)\.html$ /$1 [R=301,L]

  # Clean URL -> prerendered page (/about -> about.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Build assets in /assets/ have content hashes in their names, so they can be cached for a year
  <If "%{REQUEST_URI} =~ m#^/assets/.+\.(js|css)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers. HSTS is only sent over HTTPS, which the rewrite above enforces.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Keep this in sync with the <meta http-equiv="Content-Security-Policy"> in index.html.
  # frame-ancestors can only be set here, not in the meta tag.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://formspree.io https://plausible.io; img-src 'self' data: https:; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# Don't serve the dotfiles or the source maps
<FilesMatch "^\.|\.map$">
  Require all denied
</FilesMatch>
