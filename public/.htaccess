# Zunova Digital — Apache (GoDaddy) hosting.
# Every page is prerendered at build time to /<route>.html (and /<route>/index.html),
# so these rules serve the right file for clean URLs like /about.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  Options +FollowSymLinks -MultiViews
  DirectorySlash Off
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and drop "www." so there is one canonical address
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://zunovadigital.com%{REQUEST_URI} [R=301,L,NE]

  # Trailing slashes redirect to the clean URL (/about/ -> /about)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # The old services page now lives on the homepage
  RewriteRule ^services$ /#services [R=301,L,NE]

  # Clean URL -> prerendered page (/about -> about.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Build assets in /assets/ have content hashes in their names, so they can be cached for a year
  <If "%{REQUEST_URI} =~ m#^/assets/.+\.(js|css)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
